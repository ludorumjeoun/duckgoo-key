#!/usr/bin/env python3
"""Serve fake R2 objects for custom-domain verification tests."""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path
from urllib.parse import urlparse


arguments = sys.argv[1:]
try:
    output_path = Path(arguments[arguments.index("--output") + 1])
except (ValueError, IndexError):
    print("fake curl: --output is required", file=sys.stderr)
    raise SystemExit(2)

url = arguments[-1]
key = urlparse(url).path.lstrip("/")
source = Path(os.environ["FAKE_R2_DIR"]) / "objects" / key
if not source.is_file():
    print(f"fake curl: object is unavailable: {key}", file=sys.stderr)
    raise SystemExit(22)

shutil.copyfile(source, output_path)
with Path(os.environ["FAKE_R2_LOG"]).open("a", encoding="utf-8") as stream:
    stream.write(f"curl {key}\n")
